{
  "name": "blame-trail",
  "displayName": "BlameTrail",
  "description": "Inline git blame annotations (revision, date, author) controlled entirely from the editor's right-click menu.",
  "version": "1.1.1",
  "publisher": "Akop4",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akopov4/blame-trail.git"
  },
  "bugs": {
    "url": "https://github.com/Akopov4/blame-trail/issues"
  },
  "homepage": "https://github.com/Akopov4/blame-trail#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "annotate",
    "history",
    "author"
  ],
  "activationEvents": [
    "onCommand:blameTrail.annotate",
    "onCommand:blameTrail.close",
    "onCommand:blameTrail.copyRevision",
    "onCommand:blameTrail.toggleRevisionOn",
    "onCommand:blameTrail.toggleRevisionOff",
    "onCommand:blameTrail.toggleDateOn",
    "onCommand:blameTrail.toggleDateOff",
    "onCommand:blameTrail.toggleAuthorOn",
    "onCommand:blameTrail.toggleAuthorOff",
    "onCommand:blameTrail.toggleIgnoreWhitespaceOn",
    "onCommand:blameTrail.toggleIgnoreWhitespaceOff"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "blameTrail.annotate", "title": "Annotate with git blame" },
      { "command": "blameTrail.close", "title": "Close Annotation" },
      { "command": "blameTrail.copyRevision", "title": "Copy Revision Number" },
      { "command": "blameTrail.toggleRevisionOn", "title": "☐ Revision" },
      { "command": "blameTrail.toggleRevisionOff", "title": "☑ Revision" },
      { "command": "blameTrail.toggleDateOn", "title": "☐ Date" },
      { "command": "blameTrail.toggleDateOff", "title": "☑ Date" },
      { "command": "blameTrail.toggleAuthorOn", "title": "☐ Author" },
      { "command": "blameTrail.toggleAuthorOff", "title": "☑ Author" },
      { "command": "blameTrail.toggleIgnoreWhitespaceOn", "title": "☐ Ignore Whitespaces" },
      { "command": "blameTrail.toggleIgnoreWhitespaceOff", "title": "☑ Ignore Whitespaces" }
    ],
    "submenus": [
      { "id": "blameTrail.annotationView", "label": "Annotation view" }
    ],
    "menus": {
      "editor/lineNumber/context": [
        { "command": "blameTrail.annotate", "when": "!blameTrail.active", "group": "blameTrail@1" },
        { "command": "blameTrail.close", "when": "blameTrail.active", "group": "blameTrail@1" },
        { "submenu": "blameTrail.annotationView", "when": "blameTrail.active", "group": "blameTrail@2" },
        { "command": "blameTrail.copyRevision", "when": "blameTrail.active", "group": "blameTrail@3" }
      ],
      "editor/context": [
        { "command": "blameTrail.annotate", "when": "!blameTrail.active", "group": "blameTrail@1" },
        { "command": "blameTrail.close", "when": "blameTrail.active", "group": "blameTrail@1" },
        { "submenu": "blameTrail.annotationView", "when": "blameTrail.active", "group": "blameTrail@2" },
        { "command": "blameTrail.copyRevision", "when": "blameTrail.active", "group": "blameTrail@3" }
      ],
      "blameTrail.annotationView": [
        { "command": "blameTrail.toggleRevisionOn", "when": "!config.blameTrail.showRevision", "group": "1" },
        { "command": "blameTrail.toggleRevisionOff", "when": "config.blameTrail.showRevision", "group": "1" },
        { "command": "blameTrail.toggleDateOn", "when": "!config.blameTrail.showDate", "group": "1" },
        { "command": "blameTrail.toggleDateOff", "when": "config.blameTrail.showDate", "group": "1" },
        { "command": "blameTrail.toggleAuthorOn", "when": "!config.blameTrail.showAuthor", "group": "1" },
        { "command": "blameTrail.toggleAuthorOff", "when": "config.blameTrail.showAuthor", "group": "1" },
        { "command": "blameTrail.toggleIgnoreWhitespaceOn", "when": "!config.blameTrail.ignoreWhitespace", "group": "2" },
        { "command": "blameTrail.toggleIgnoreWhitespaceOff", "when": "config.blameTrail.ignoreWhitespace", "group": "2" }
      ]
    },
    "configuration": {
      "title": "BlameTrail",
      "properties": {
        "blameTrail.showRevision": {
          "type": "boolean",
          "default": false,
          "description": "Show the revision (commit hash) in the inline blame annotation."
        },
        "blameTrail.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Show the commit date in the inline blame annotation."
        },
        "blameTrail.dateFormat": {
          "type": "string",
          "enum": ["YYYY-MM-DD", "YYYY/MM/DD", "MM/DD/YYYY", "MM-DD-YYYY"],
          "default": "YYYY-MM-DD",
          "description": "Date format used in the inline blame annotation and the hover tooltip."
        },
        "blameTrail.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Show the author in the inline blame annotation."
        },
        "blameTrail.authorFormat": {
          "type": "string",
          "enum": ["Initials", "First Name", "Last Name", "E-mail"],
          "default": "First Name",
          "description": "How the author is displayed in the inline blame annotation. Falls back to e-mail (or name) when the chosen format can't be derived."
        },
        "blameTrail.maxAuthorLength": {
          "type": "number",
          "default": 12,
          "minimum": 3,
          "description": "Maximum number of characters shown for the author field before truncating with an ellipsis."
        },
        "blameTrail.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Ignore whitespace changes when computing git blame (-w)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.4.0"
  }
}
